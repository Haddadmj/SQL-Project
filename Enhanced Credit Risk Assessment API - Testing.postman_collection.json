    {
      "name": "Create Accounts Link",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = JSON.parse(responseBody);\r",
              "pm.collectionVariables.set(\"AccountsLinkId\", jsonData.Data.AccountsLinkId);\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "let raw = pm.collectionVariables.get(\"Id\");\r",
              "let current = parseInt(raw, 10) || 0;\r",
              "let next = current + 1;\r",
              "\r",
              "// Pad the number to be at least 3 characters long with leading zeros\r",
              "let paddedId = next.toString().padStart(3, '0');\r",
              "\r",
              "pm.collectionVariables.set(\"Id\", next.toString());\r",
              "pm.collectionVariables.set(\"PSUId\", `acctest${paddedId}`);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
